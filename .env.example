# Optional. Leave blank to run with verified fallback questions only.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.6-flash

# Optional local path; the API defaults to this repository-local database.
ASSESSMENT_ANALYTICS_DB_PATH=assessment_analytics.db

# Required by FastAPI for GET /api/teacher/live. Use the same value for
# TEACHER_DASHBOARD_TOKEN in web/.env.local.
TEACHER_DASHBOARD_TOKEN=replace-with-secure-backend-token

# Optional operational settings.
LIVE_GENERATION_COOLDOWN_SECONDS=120

# Development default. Replace with the deployed web origin in production.
WEB_ORIGINS=http://localhost:3000

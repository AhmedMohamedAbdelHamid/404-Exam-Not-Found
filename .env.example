# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead. Never commit real values.

# Google Gemini key for live question generation. Optional: without it the app
# serves the verified fallback question pool.
GEMINI_API_KEY=

# Supabase Postgres connection string (Session pooler URI):
#   Supabase -> Project Settings -> Database -> Connection string -> URI
# Must start with postgresql://  (NOT the https://<ref>.supabase.co project URL).
# Optional: when unset, the API falls back to a temporary local SQLite store.
DATABASE_URL=

# Leave EMPTY on Vercel (the API is served from the same origin).
# For `next dev`, http://localhost:8000 is used automatically.
NEXT_PUBLIC_API_BASE_URL=

# Env example
# Copy to .env.local for local development. On Vercel, set these under
# Project Settings -> Environment Variables instead. Never commit real values.

# Google Gemini key for live question generation. Optional: without it the app
# serves the verified fallback question pool.
GEMINI_API_KEY=

# Supabase Postgres connection string -- REQUIRED on Vercel.
#   Supabase -> Project Settings -> Database -> Connection string -> URI
#   (Session pooler, port 5432; the Transaction pooler, port 6543, also works)
# Looks like:
#   postgresql://postgres.<project-ref>:<PASSWORD>@aws-0-<region>.pooler.supabase.com:5432/postgres
# It is NOT the https://<ref>.supabase.co project URL. If your password contains
# special characters (@ : / # ? %) they must be percent-encoded.
# On Vercel the app refuses to start a quiz without a valid value (an unset or
# wrong URL used to fall back to per-instance SQLite, which lost attempts:
# "This assessment attempt was not found"). Tables and textbook chunks are
# created/seeded automatically on first use. Locally, leaving it unset uses a
# temporary SQLite file.
DATABASE_URL=

# Leave EMPTY on Vercel (the API is served from the same origin).
# For `next dev`, http://localhost:8000 is used automatically.
NEXT_PUBLIC_API_BASE_URL=

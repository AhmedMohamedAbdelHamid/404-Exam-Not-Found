# Browser-visible student API URL. This is the only public variable below.
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000

# Next.js server-only configuration. Do not rename these with NEXT_PUBLIC_.
API_INTERNAL_BASE_URL=http://127.0.0.1:8000
# Must exactly match TEACHER_DASHBOARD_TOKEN configured for FastAPI.
TEACHER_DASHBOARD_TOKEN=replace-with-same-backend-token
# Separate credential entered on the Teacher Access screen.
TEACHER_UI_ACCESS_TOKEN=replace-with-secure-teacher-access-token
